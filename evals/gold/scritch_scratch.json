    {"id": "gurteen_warning", "label": "Old Gurteen reveals that rats feed the waking trees and urges destruction of the woods", "aliases": ["Speaking with Gurteen", "Burn it all", "Feed the wood"], "kind": "clue", "scenario_id": "main"},
