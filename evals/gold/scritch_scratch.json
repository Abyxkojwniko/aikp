    {"id": "flee_muscoby", "label": "Escape Muscoby by car without resolving the ancient cycle", "aliases": ["driving as fast as possible"], "kind": "ending", "scenario_id": "main"},
    {"id": "tribute_deaths", "label": "Investigator deaths satiate the Green Man only temporarily", "aliases": ["Each death helps satiate the Green Man"], "kind": "ending", "scenario_id": "main"},
