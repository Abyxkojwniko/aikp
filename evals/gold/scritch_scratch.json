    {"id": "kitchen_resources", "label": "Find the unsafe gas cooker, wooden spills, matches, and kitchen torch", "aliases": ["The Kitchen"], "kind": "clue", "scenario_id": "main"},
    {"id": "courtyard_chemicals", "label": "Identify illegal poisons and herbicides in the courtyard chemical store", "aliases": ["The Courtyard", "chemical storage area"], "kind": "clue", "scenario_id": "main"},
