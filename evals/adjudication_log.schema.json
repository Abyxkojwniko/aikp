{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abyxkojwniko/aikp/evals/adjudication_log.schema.json",
  "title": "AIKP annotation adjudication log",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "module_id",
      "item_type",
      "item_key",
      "annotator_a",
      "annotator_b",
      "decision",
      "reason",
      "adjudicator"
    ],
    "properties": {
      "module_id": {"type": "string", "minLength": 1},
      "item_type": {
        "enum": ["scenario", "node", "edge", "entity", "narrative_scope"]
      },
      "item_key": {"type": "string", "minLength": 1},
      "annotator_a": {},
      "annotator_b": {},
      "decision": {},
      "reason": {"type": "string", "minLength": 1},
      "source_locator": {"type": "string"},
      "adjudicator": {"type": "string", "minLength": 1},
      "timestamp": {"type": "string", "format": "date-time"}
    }
  }
}
