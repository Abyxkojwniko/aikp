# Copy this file to ".env" and fill in your own key.  Never commit ".env".
#
#   cp .env.example .env        # then edit .env
#
# Get a key at https://platform.deepseek.com/  (OpenAI-compatible).

# Required: your DeepSeek API key
DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides (defaults shown)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional prompt budgets. Current-scene source is kept as canonical evidence;
# low-priority history is compacted before any control instructions are dropped.
AIKP_MAX_CONTEXT_CHARS=24000
AIKP_MAX_SCENE_SOURCE_CHARS=6000
# One-shot complete-document limit. Larger modules use bounded document maps,
# synthesize a global story tree, then return to the original source by ref.
AIKP_FULL_REBUILD_MAX_CHARS=180000
AIKP_LONG_DOCUMENT_WINDOW_CHARS=52000
AIKP_NODE_SOURCE_MAX_CHARS=30000
AIKP_NODE_QUALITY_THRESHOLD=82
AIKP_NODE_REBUILD_MAX_RETRIES=2
# Research-only: full | legacy | no_document_map | no_semantic_judge | no_node_repair
AIKP_PARSER_ABLATION=full
